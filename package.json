{
  "name": "consoless",
  "private": true,
  "version": "0.1.0",
  "description": "A friendly graphical command line for macOS, Windows, Linux, and home routers",
  "homepage": "https://github.com/syprayt/Consoless",
  "license": "MIT",
  "author": "Consoless contributors",
  "desktopName": "consoless.desktop",
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syprayt/Consoless.git"
  },
  "bugs": {
    "url": "https://github.com/syprayt/Consoless/issues"
  },
  "keywords": [
    "electron",
    "command-line",
    "gui",
    "macos",
    "windows",
    "linux",
    "router",
    "openwrt"
  ],
  "scripts": {
    "dev": "vite",
    "start": "npm run build:electron && concurrently -k -n vite,app \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "icon": "node scripts/write-icon.mjs",
    "pack": "npm run icon && npm run build && electron-builder --mac --win --linux --publish never",
    "pack:win": "npm run icon && npm run build && electron-builder --win --publish never",
    "pack:linux": "npm run icon && npm run build && electron-builder --linux --publish never",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.consoless.app",
    "productName": "Consoless",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "identity": "-",
      "gatekeeperAssess": false,
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Consoless",
      "artifactName": "Consoless-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Consoless contributors <consoless@users.noreply.github.com>",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.5"
  }
}
